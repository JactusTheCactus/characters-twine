State.variables.characters = {};
fetch("src/data.json")
    .then(function (response) { return response.json(); })
    .then(function (data) {
    Object.entries(data.characters).forEach(function (_a) {
        var k = _a[0], v = _a[1];
        v.names.name = v.names.name
            .join(" ");
        v.names.pron = v.names.pron
            .map(function (i) { return i.join(""); })
            .join("\u00B7");
        State.variables.characters[k] = v;
    });
    Engine.play("Main");
})
    .catch(function (error) { return console.error("Error loading JSON:", error); });
