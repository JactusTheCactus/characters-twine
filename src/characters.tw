:: characters
<<set $characters to {}>>
<<for _i range ["hound", "morrigan"]>>
	<<set $characters[_i] to {
		names: {
			name: "John Doe",
			pronunciation: `D${$u.ezh}on D${$u.omega}`
		},
		species: "Human",
		sex: "Neuter",
		extra: []
	}>>
<</for>>
<<set $characters.hound.names.name to "Hound">>
<<set $characters.hound.names.pronunciation to "H[a-u]nd">>
<<set $characters.hound.species to "Changeling">>
<<set $characters.hound.sex to "Female">>
<<set $characters.hound.extra.push("Shapeshifts into a large, black Wolf")>>
<<set $characters.morrigan.names.name to "Morrigan">>
<<set $characters.morrigan.names.pronunciation to `M${$u.omega+$u.acute}r${$u.schwa}gy${$u.grave}n`>>
<<set $characters.morrigan.species to "Reaper">>
<<set $characters.morrigan.sex to "Female">>
<<set $characters.morrigan.extra.push("Wields a scythe")>>
<<set $characters.morrigan.extra.push("Killing Touch")>>